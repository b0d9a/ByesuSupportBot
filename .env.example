# ByesuSupportBot environment configuration
# Copy this file to `.env` and fill in real values before running the bot.
# Variables are loaded via `dotenv/config` (see src/config.ts).

# --- Required ---

# Telegram bot token from @BotFather. Required. The bot fails to start without it.
BOT_TOKEN=replace_with_botfather_token

# PostgreSQL connection string. Required by both the bot and `npm run migrate`.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://byesu:byesu@127.0.0.1:55432/byesu_support_dev

# Numeric Telegram chat id of the support forum supergroup. Required.
# Must be an integer (usually a large negative number, e.g. -100...). The bot
# must be an admin of this group with forum topics enabled.
SUPPORT_GROUP_ID=-1001234567890

# --- Optional ---

# Log verbosity. Optional. Defaults to "info". Common values: error, warn, info, debug.
LOG_LEVEL=info

# AI assistant (optional). When AI_ENABLED=true, the bot first tries to answer
# new questions from the FAQ knowledge base before opening a ticket.
# Set to "true" to enable; any other value (or unset) disables the AI path.
AI_ENABLED=false

# AI gateway API key (Byesu / OpenAI-compatible). Optional unless AI_ENABLED=true,
# in which case it is REQUIRED — the bot fails to start with AI_ENABLED=true and no key.
AI_API_KEY=sk-xxxxxxxxxxxxxxxx

# AI gateway base URL. Optional. Defaults to https://byesu.com/v1 when unset.
AI_BASE_URL=https://byesu.com/v1

# AI model name. Optional. Defaults to gpt-5.5 when unset.
AI_MODEL=gpt-5.5

# Raw-text retention window (days) for scripts/purge_raw_support_text.ts.
# Optional. Defaults to 90. Only used by the purge job, not by the bot at runtime.
SUPPORT_TEXT_RETENTION_DAYS=90
