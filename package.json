{
  "name": "byesu-support-bot",
  "version": "0.1.0",
  "description": "Telegram support bot that routes messages by intent into moderator forum topics, with deterministic and AI-assisted knowledge-base answers backed by PostgreSQL.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0d9a/byesusupportbot.git"
  },
  "bugs": {
    "url": "https://github.com/b0d9a/byesusupportbot/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^6.45.0",
    "pg": "^8.13.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
